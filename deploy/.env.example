# Postgres: application credentials (the image creates the user and the database)
POSTGRES_DB=popcorn
POSTGRES_USER=popcorn
POSTGRES_PASSWORD=changeme-app

# JWT: real key, e.g. openssl rand -base64 64
JWT_KEY=changeme-jwt-secret-min-32-chars

# TMDB v3 API key (proxied by the backend)
TMDB_API_KEY=changeme-tmdb-key

# HTTP port exposed on the host (target of the server's reverse proxy)
HTTP_PORT=8080
