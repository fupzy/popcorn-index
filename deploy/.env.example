# Postgres : superuser (init du conteneur)
POSTGRES_ROOT_PASSWORD=changeme-root

# Postgres : credentials applicatifs (crees par database/init.sql)
POSTGRES_DB=popcorn
POSTGRES_USER=popcorn
POSTGRES_PASSWORD=changeme-app

# JWT : vraie cle, ex: openssl rand -base64 64
JWT_KEY=changeme-jwt-secret-min-32-chars

# Port d'exposition du frontend nginx
UI_PORT=8080
